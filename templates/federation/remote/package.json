{
  "name": "baize-reports-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dependencies.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-dependencies.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint src scripts .storybook && prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \".storybook/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quality": "node scripts/quality.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "@module-federation/vite": "1.23.7",
    "oxlint": "1.90.0",
    "prettier": "3.6.2",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
