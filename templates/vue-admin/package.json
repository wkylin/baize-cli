{
  "name": "baize-vue-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dependencies.mjs && node scripts/generate-routes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-dependencies.mjs && node scripts/generate-routes.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "oxlint src scripts .storybook && prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\"",
    "pretypecheck": "node scripts/generate-routes.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "quality": "node scripts/quality.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "@lucide/vue": "1.66.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.0",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@storybook/vue3": "10.6.5",
    "@storybook/vue3-vite": "10.6.5",
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "6.0.10",
    "oxlint": "1.90.0",
    "prettier": "3.6.2",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
