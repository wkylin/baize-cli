{
  "name": "baize-cli",
  "version": "1.3.0",
  "description": "Create reusable React and Vue admin projects from focused local templates",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "baize": "./bin/index.js"
  },
  "scripts": {
    "start": "node bin/index.js",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,html,json,md}\"",
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "react",
    "vue",
    "pinia",
    "cli",
    "admin",
    "typescript",
    "baize"
  ],
  "files": [
    "bin/",
    "src/",
    "templates/react-admin/_gitignore",
    "templates/react-admin/.baize.json",
    "templates/react-admin/.prettierrc",
    "templates/react-admin/.storybook/",
    "templates/react-admin/README.md",
    "templates/react-admin/index.html",
    "templates/react-admin/package.json",
    "templates/react-admin/tsconfig.json",
    "templates/react-admin/vite.config.ts",
    "templates/react-admin/webpack.config.mjs",
    "templates/react-admin/public/",
    "templates/react-admin/scripts/",
    "templates/react-admin/src/",
    "templates/federation/host/",
    "templates/federation/remote/.prettierrc",
    "templates/federation/remote/.storybook/",
    "templates/federation/remote/package.json",
    "templates/federation/remote/tsconfig.json",
    "templates/federation/remote/vite.config.ts",
    "templates/federation/remote/webpack.mfe.config.mjs",
    "templates/federation/remote/src/",
    "templates/storybook/webpack.main.ts",
    "templates/shared/",
    "templates/workspace/README.md",
    "templates/workspace/scripts/workspace.mjs",
    "templates/wui/",
    "templates/vue-admin/_gitignore",
    "templates/vue-admin/.baize.json",
    "templates/vue-admin/.prettierrc",
    "templates/vue-admin/.storybook/",
    "templates/vue-admin/README.md",
    "templates/vue-admin/index.html",
    "templates/vue-admin/package.json",
    "templates/vue-admin/tsconfig.json",
    "templates/vue-admin/vite.config.ts",
    "templates/vue-admin/public/",
    "templates/vue-admin/scripts/",
    "templates/vue-admin/src/",
    "templates/vue-federation/host/",
    "templates/vue-federation/remote/.prettierrc",
    "templates/vue-federation/remote/.storybook/",
    "templates/vue-federation/remote/index.html",
    "templates/vue-federation/remote/package.json",
    "templates/vue-federation/remote/tsconfig.json",
    "templates/vue-federation/remote/vite.config.ts",
    "templates/vue-federation/remote/src/",
    "docs/PROJECT_ANALYSIS.md",
    "docs/PUBLISHING.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "wkylin.w",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wkylin/baize-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wkylin/baize-cli/issues"
  },
  "homepage": "https://github.com/wkylin/baize-cli"
}
